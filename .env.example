# Rentaliq Environment Configuration Example
# Set your API key here so all users and inquiries automatically use the LLM agent.

# Global LLM Execution Mode (Standard for all users)
RENTALIQ_EXECUTION_MODE=LLM

# LLM Provider Configuration
# Set either GEMINI_API_KEY / GOOGLE_API_KEY for Google Gemini, or OPENAI_API_KEY for OpenAI.
# You can also use RENTALIQ_LLM_API_KEY directly.
RENTALIQ_LLM_PROVIDER=gemini
RENTALIQ_LLM_API_KEY=
RENTALIQ_LLM_MODEL=gemini-1.5-flash

# Alternative direct provider keys (auto-detected):
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Orchestration parameters
RENTALIQ_MAX_ITERATIONS=5
RENTALIQ_MIN_CONFIDENCE_FOR_AUTO=0.70
RENTALIQ_MIN_QUALIFICATION_SCORE=85.0

# Database path (defaults to rentaliq.db in workspace root)
RENTALIQ_DB_PATH=rentaliq.db
